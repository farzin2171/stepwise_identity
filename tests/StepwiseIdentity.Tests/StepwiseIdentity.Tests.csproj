<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="MassTransit.TestFramework" Version="8.3.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SINGLE test project for the whole repo, per the phase conventions — it references whichever
         projects hold logic worth a table, and grows as phases add branches. Today that's
         IdentityServerHost (Phase 11's id conversion), Mini.Infrastructure (the identity-type rules
         every service in this repo now depends on), Mini.UserService (Phase 12's two connector
         decision tables: which connector serves this tenant, and what a chain's outcome is) and
         Mini.AuthorizationService (Phase 15's decision-cache expiry rule). -->
    <ProjectReference Include="..\..\src\IdentityServerHost\IdentityServerHost.csproj" />
    <ProjectReference Include="..\..\src\Mini.Infrastructure\Mini.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Mini.UserService\Mini.UserService.csproj" />
    <ProjectReference Include="..\..\src\Mini.AuthorizationService\Mini.AuthorizationService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
