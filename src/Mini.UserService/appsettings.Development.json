{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "ServiceDb": "Server=(localdb)\\mssqllocaldb;Database=MiniUsers;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Authentication": {
    "Authority": "https://localhost:5001"
  },

  "ExternalServicesApi": {
    "ServiceAccount": {
      "TokenEndpoint": "https://localhost:5001/connect/token",
      "ClientId": "userservice-svc",
      "TenantSecrets": {
        "acme": "acme-userservice-secret",
        "globex": "globex-userservice-secret",
        "initech": "initech-userservice-secret"
      }
    },
    "ServiceDefinitions": {
      "IdentityGateway": {
        "BaseUri": "https://localhost:5001",
        "Path": "",
        "HealthPath": "/health"
      }
    }
  }
}
