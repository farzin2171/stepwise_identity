{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Authentication": {
    "Authority": "https://localhost:5001",
    "Audience": "acmeapi",

    // The ONE service account this API will answer. Acme's own system trusts the DIT platform's
