@model IdentityServerHost.Controllers.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><title>Mini IdG — Login</title></head>
<body style="font-family: sans-serif; max-width: 320px; margin: 4rem auto;">
  <h2>Sign in@(Model.TenantDisplayName is not null ? $" to {Model.TenantDisplayName}" : "")</h2>
  @if (!ViewData.ModelState.IsValid)
  {
    <p style="color: #991b1b;">@ViewData.ModelState.Values.First().Errors.First().ErrorMessage</p>
  }
  @if (Model.ExternalProviders.Any())
  {
    <div style="margin-bottom: 1.2rem;">
      @foreach (var provider in Model.ExternalProviders)
      {
        <a href="/External/Challenge?scheme=@provider.Name&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")"
           style="display: block; padding: 0.5rem; margin-bottom: 0.5rem; background: #eef6ff; border: 1px solid #bcd; text-align: center; text-decoration: none; color: #145;">
          Sign in with @provider.DisplayName
        </a>
      }
    </div>
    <p style="text-align: center; color: #999; font-size: 0.8rem;">— or —</p>
  }
  <form asp-controller="Account" asp-action="Login" method="post">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <p><label>Username<br /><input type="text" name="Username" /></label></p>
    <p><label>Password<br /><input type="password" name="Password" /></label></p>
    <button type="submit">Login</button>
  </form>
  <p style="color: #666; font-size: 0.85rem;">
    Try <code>alice</code> / <code>alice</code> (Acme Corp) or <code>bob</code> / <code>bob</code>
    (Globex Corporation).
  </p>
</body>
</html>
